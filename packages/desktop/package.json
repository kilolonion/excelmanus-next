{
  "name": "@excelmanus/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "pack": "node scripts/pack.ts",
    "start": "node scripts/build.ts && electron build/app",
    "self-test": "node scripts/build.ts && electron build/app --self-test"
  },
  "dependencies": {
    "@excelmanus/core": "workspace:*",
    "@excelmanus/protocol": "workspace:*",
    "@excelmanus/server": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.3",
    "esbuild": "0.28.2"
  }
}
